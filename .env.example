# Copy to .env. Defaults match infra/docker-compose.yml.
HOPE_DATABASE_URL=postgresql://hope_app:hope_app@localhost:5432/hope
HOPE_DATABASE_SYSTEM_URL=postgresql://hope_system:hope_system@localhost:5432/hope
HOPE_DATABASE_ADMIN_URL=postgresql://hope:hope@localhost:5432/hope
HOPE_KAFKA_BOOTSTRAP=localhost:19092
HOPE_REDIS_URL=redis://localhost:6379/0
HOPE_TEMPORAL_ADDRESS=localhost:7233
HOPE_S3_ENDPOINT=http://localhost:9000
HOPE_MODEL_PROVIDER=mock
# Optional. Unset = offline (MockProvider + recorded fixtures). `make demo` copies either one to the other.
HOPE_OPENAI_API_KEY=
OPENAI_API_KEY=
# Required to sign in (at least 16 characters); `make demo` writes one to .env.
HOPE_SESSION_SECRET=
HOPE_INVITE_CODE=
