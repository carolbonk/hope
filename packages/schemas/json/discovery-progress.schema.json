{
  "$id": "https://schemas.hope.dev/discovery-progress/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidates_found": {
      "default": 0,
      "title": "Candidates Found",
      "type": "integer"
    },
    "current_step": {
      "default": "",
      "title": "Current Step",
      "type": "string"
    },
    "pages_read": {
      "default": 0,
      "title": "Pages Read",
      "type": "integer"
    },
    "queries_done": {
      "default": 0,
      "title": "Queries Done",
      "type": "integer"
    },
    "queries_total": {
      "default": 0,
      "title": "Queries Total",
      "type": "integer"
    }
  },
  "title": "DiscoveryProgress",
  "type": "object"
}
