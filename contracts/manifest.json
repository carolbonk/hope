      "next_routes": [
        {
          "method": "POST",
          "path": "/api/hope/draft",
          "request": {
            "locale": "en",
            "mode": "agent",
            "ask": 50000,
            "profile": {},
            "opportunity": {
              "id": "opp-bayfront-youth",
              "funder": "Bayfront Community Fund (demo)",
              "name": "Youth Mentoring Grants",
              "currency": "USD",
              "amountMin": 25000,
              "amountMax": 50000
            }
          },
          "responses": {
            "200": "{ source: agent|template, model?, sections{program,alignment,logicModel,objectives,budget,budgetNarrative}, reviewerNotes[] }",
