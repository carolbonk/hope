      "goal": "One click turns the profile into a list of real, open grants, found like a web search.",
      "steps": [
        {
          "name": "Read the profile into a digest",
          "kind": "code",
          "detail": "No model.",
          "calls_per_run": null,
          "model": null
        },
        {
          "name": "Plan 5-8 search queries",
          "kind": "llm",
          "detail": "Structured QueryPlan.",
          "calls_per_run": "1",
          "model": "gpt-4o-mini (MID)"
        },
        {
          "name": "Web search each query",
          "kind": "web",
          "detail": "OpenAI Responses API with the web_search tool (search model).",
          "calls_per_run": "5-8",
          "model": "gpt-4o-mini search"
        },
        {
          "name": "De-duplicate URLs, block directories, check robots.txt",
          "kind": "code",
          "detail": "No model.",
          "calls_per_run": null,
          "model": null
        },
        {
          "name": "Fetch each page (httpx, SSRF guard, 15 s, 5 MB)",
          "kind": "code",
          "detail": "No model. Page text is never stored.",
          "calls_per_run": "up to 30 fetches",
          "model": null
        },
        {
          "name": "Classify the page and extract funder, amount, deadline, eligibility with quotes",
          "kind": "llm",
          "detail": "Structured PageExtraction; untrusted page text.",
          "calls_per_run": "up to 2 per candidate",
          "model": "gpt-4o-mini (MID)"
        },
        {
          "name": "Verify quotes, parse amounts and dates, drop expired",
          "kind": "code",
          "detail": "Money in integer cents; dates by a strict parser.",
          "calls_per_run": null,
          "model": null
        },
        {
          "name": "Score fit 0-100 with reasons and concerns",
          "kind": "llm",
          "detail": "Structured FitAssessment; code keeps only cited reasons.",
          "calls_per_run": "1 per candidate",
          "model": "gpt-4o-mini (MID)"
        },
        {
          "name": "Save candidates",
          "kind": "code",
          "detail": "Upsert grant_candidates.",
          "calls_per_run": null,
          "model": null
        }
      ],
