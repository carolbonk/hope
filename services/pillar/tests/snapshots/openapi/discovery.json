{
  "components": {
    "schemas": {
      "DiscoveryCounts": {
        "properties": {
          "candidates_new": {
            "default": 0,
            "title": "Candidates New",
            "type": "integer"
          },
          "candidates_updated": {
            "default": 0,
            "title": "Candidates Updated",
            "type": "integer"
          },
          "failed_pages": {
            "default": 0,
            "title": "Failed Pages",
            "type": "integer"
          },
          "pages_read": {
            "default": 0,
            "title": "Pages Read",
            "type": "integer"
          },
          "queries_failed": {
            "default": 0,
            "title": "Queries Failed",
            "type": "integer"
          },
          "skipped_expired": {
            "default": 0,
            "title": "Skipped Expired",
            "type": "integer"
          },
          "skipped_known": {
            "default": 0,
            "title": "Skipped Known",
            "type": "integer"
          },
          "skipped_not_grant": {
            "default": 0,
            "title": "Skipped Not Grant",
            "type": "integer"
          },
          "skipped_poor_fit": {
            "default": 0,
            "title": "Skipped Poor Fit",
