            "title": "Is New",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "new",
              "saved",
              "passed"
            ],
            "title": "Status",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
