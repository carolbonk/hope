        "required": [
          "grant_id",
          "title",
          "funder",
          "url",
          "fit_score",
          "amount_text",
          "amount_max",
          "deadline_text",
          "deadline",
          "summary",
          "is_new",
          "status"
        ],
        "title": "JobCandidate",
        "type": "object"
      },
      "Money": {
        "properties": {
          "amount_minor": {
            "title": "Amount Minor",
            "type": "integer"
          },
          "currency": {
            "default": "USD",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount_minor"
        ],
        "title": "Money",
        "type": "object"
      },
      "StartDiscoveryBody": {
        "additionalProperties": false,
        "properties": {
          "focus_keywords": {
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "title": "Focus Keywords",
            "type": "array"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          }
        },
        "title": "StartDiscoveryBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
