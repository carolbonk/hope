          "urls_found": {
            "default": 0,
            "title": "Urls Found",
            "type": "integer"
          }
        },
        "title": "DiscoveryCounts",
        "type": "object"
      },
      "DiscoveryJob": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "progress": {
            "$ref": "#/components/schemas/DiscoveryProgress"
          },
          "queries": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Queries",
            "type": "array"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "done",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status",
          "progress",
          "started_at"
        ],
        "title": "DiscoveryJob",
        "type": "object"
      },
      "DiscoveryJobView": {
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/JobCandidate"
            },
            "title": "Candidates",
            "type": "array"
          },
          "counts": {
            "$ref": "#/components/schemas/DiscoveryCounts"
          },
          "elapsed_s": {
            "title": "Elapsed S",
            "type": "integer"
          },
          "job": {
            "$ref": "#/components/schemas/DiscoveryJob"
          },
          "last_seq": {
            "title": "Last Seq",
            "type": "integer"
          },
          "limits": {
            "$ref": "#/components/schemas/DiscoveryLimits"
          },
          "request": {
            "$ref": "#/components/schemas/DiscoveryRequest"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/DiscoveryStep"
            },
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "job",
          "request",
          "counts",
          "steps",
          "last_seq",
          "candidates",
          "elapsed_s",
          "limits"
        ],
        "title": "DiscoveryJobView",
        "type": "object"
      },
      "DiscoveryLimits": {
        "properties": {
          "max_pages": {
            "title": "Max Pages",
            "type": "integer"
          },
          "max_queries": {
            "title": "Max Queries",
            "type": "integer"
          },
          "timeout_s": {
            "title": "Timeout S",
            "type": "integer"
          }
        },
        "required": [
          "max_queries",
          "max_pages",
          "timeout_s"
        ],
        "title": "DiscoveryLimits",
        "type": "object"
      },
      "DiscoveryProgress": {
        "additionalProperties": false,
        "properties": {
          "candidates_found": {
            "default": 0,
            "title": "Candidates Found",
            "type": "integer"
          },
          "current_step": {
            "default": "",
            "title": "Current Step",
            "type": "string"
          },
          "pages_read": {
            "default": 0,
            "title": "Pages Read",
            "type": "integer"
          },
          "queries_done": {
            "default": 0,
            "title": "Queries Done",
            "type": "integer"
          },
          "queries_total": {
            "default": 0,
            "title": "Queries Total",
            "type": "integer"
          }
        },
        "title": "DiscoveryProgress",
        "type": "object"
      },
      "DiscoveryRequest": {
        "properties": {
          "focus_keywords": {
            "items": {
              "type": "string"
            },
            "title": "Focus Keywords",
            "type": "array"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          }
        },
        "required": [
          "focus_keywords",
          "location"
        ],
        "title": "DiscoveryRequest",
        "type": "object"
      },
      "DiscoveryRunList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/DiscoveryRunSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "running_job_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Running Job Id"
          }
        },
        "required": [
          "items",
          "running_job_id"
        ],
        "title": "DiscoveryRunList",
        "type": "object"
      },
      "DiscoveryRunSummary": {
        "properties": {
          "candidates_found": {
            "title": "Candidates Found",
            "type": "integer"
          },
          "candidates_new": {
            "title": "Candidates New",
            "type": "integer"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "pages_read": {
            "title": "Pages Read",
            "type": "integer"
          },
          "queries_total": {
            "title": "Queries Total",
            "type": "integer"
          },
          "request": {
            "$ref": "#/components/schemas/DiscoveryRequest"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "done",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status",
          "started_at",
          "finished_at",
          "request",
          "queries_total",
          "pages_read",
          "candidates_found",
          "candidates_new",
          "error"
        ],
        "title": "DiscoveryRunSummary",
        "type": "object"
      },
      "DiscoveryStep": {
        "additionalProperties": true,
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobCandidate": {
        "properties": {
          "amount_max": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Money"
              },
              {
                "type": "null"
              }
            ]
          },
          "amount_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount Text"
          },
          "deadline": {
            "anyOf": [
              {
                "format": "date",
