OPENAI_API_KEY=
# Optional: override the OpenAI Agents SDK default model.
OPENAI_MODEL=
# Leave empty to use the built-in onboarding fixtures; set to the API (or `pnpm mock`) to use /v1.
NEXT_PUBLIC_HOPE_API_URL=
