# Leave NEXT_PUBLIC_HOPE_API_URL empty to use the built-in fixture client (no backend needed).
# The HTTP client targets the pillar /v1 API (services/pillar).
NEXT_PUBLIC_HOPE_API_URL=
NEXT_PUBLIC_HOPE_TENANT_ID=
NEXT_PUBLIC_HOPE_AGENCY_ID=
# Dev principal sent as X-Hope-User / X-Hope-Roles until OIDC is wired.
NEXT_PUBLIC_HOPE_USER_ID=
NEXT_PUBLIC_HOPE_ROLES=program_director,finance_director,executive_director,aor
# Channel for HITL-5 package authorization.
NEXT_PUBLIC_HOPE_SUBMISSION_CHANNEL=grants_gov
